rules_version = '2';
// Paste into Firebase console > Firestore > Rules (or `firebase deploy --only firestore:rules`).
// Each signed-in user can read and write only their own doc, and only the shortlist (max 30 ids, like the app).
service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow create, update: if request.auth != null && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['shortlist', 'updated_at'])
        && request.resource.data.shortlist is list
        && request.resource.data.shortlist.size() <= 30
        && request.resource.data.updated_at == request.time;
    }
  }
}
